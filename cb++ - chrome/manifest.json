{
  "manifest_version": 3,
  "name": "Cb++",
  "version": "1.0.0",
  "description": "Add member ignore controls and display settings to ChatBlink.",
  "permissions": ["storage"],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Cb++",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatblink.com/*",
        "https://www.chatblink.com/*"
      ],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
